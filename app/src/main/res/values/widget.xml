<resources>
    <string name="widget_name">Stillwave Recorder</string>
    <string name="widget_description">Record, pause, add checkpoints, save or discard from your home screen.</string>
    <string name="widget_ready">Tap a preset or Best available to record</string>
    <string name="widget_zero_time">00:00</string>
    <string name="widget_voice">● Voice\n16000 Hz\n256 kbps</string>
    <string name="widget_balanced">● Balanced\n44100 Hz\n705.6 kbps</string>
    <string name="widget_studio">● Studio\n48000 Hz\n1536 kbps</string>
    <string name="widget_pause">Ⅱ  Pause recording</string>
    <string name="widget_checkpoint">Add checkpoint</string>
    <string name="widget_save">Stop &amp; save</string>
    <string name="widget_discard">Stop &amp; discard</string>
    <string name="widget_confirm_question">Discard this recording?</string>
    <string name="widget_confirm">Discard recording</string>
    <string name="widget_cancel">Keep recording</string>
    <style name="WidgetButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#F3F5ED</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:padding">4dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="WidgetButton.Primary">
        <item name="android:background">@drawable/widget_record_button</item>
        <item name="android:textColor">#17200D</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.Stillwave.WidgetPermission" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#C5F277</item>
    </style>
    <string name="widget_best">● Best available · Auto</string>
</resources>
